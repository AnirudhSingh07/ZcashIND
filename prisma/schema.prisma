// ZcashIND Prisma schema — SQLite for MVP.
// Enums are stored as strings (SQLite has no native enum support).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A meetup / event / merchant pin. Public map shows only status = "verified".
model Meetup {
  id     String @id @default(cuid())
  slug   String @unique

  // kind: official_event | irl_bounty | merchant
  kind   String @default("irl_bounty")
  // status: pending | needs_info | verified | rejected | disqualified
  status String @default("pending")

  title   String
  city    String
  state   String?
  country String @default("India")

  lat Float
  lng Float

  // venueType: college | cafe | hostel | coworking | office | public | online | other
  venueType String  @default("other")
  venueName String?

  startsAt        DateTime
  endsAt          DateTime?
  timezone        String   @default("Asia/Kolkata")
  durationMinutes Int      @default(20)
  isOnline        Boolean  @default(false)
  language        String?

  // format: privacy_talk | zcash_intro | ironwood | quiz | dev | chai_privacy | college_discussion | live_stream | workshop | other
  format String @default("other")

  description String?
  summary     String?

  attendeesTotal      Int @default(0)
  attendeesNewToZcash Int @default(0)

  newCityActivation Boolean @default(false)
  nodeNumber        Int?

  registrationUrl String?

  // photos stored as a JSON string array of /uploads/... paths
  photos String @default("[]")

  brandingVisible Boolean @default(false)

  // Public-facing host name (safe to display).
  hostNamePublic String?
  // Private contact — NEVER exposed on public routes. Admin only.
  hostContactPrivate String?

  hostContributor   Contributor? @relation(fields: [hostContributorId], references: [id])
  hostContributorId String?

  bountyPeriod String? // e.g. "2026-09"

  adminNotes      String?
  rejectionReason String?

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([status])
  @@index([kind])
  @@index([city])
}

/// A recognised Zcash India contributor.
model Contributor {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  bio    String?
  city   String?
  telegram String?
  x        String?
  avatar   String?
  official Boolean @default(false)

  meetups Meetup[]

  createdAt DateTime @default(now())
}

/// Hand-picked @ZcashIND posts spotlighted on the site (admin-managed).
/// Powers the "Latest from @ZcashIND" feature when X's live widget can't render.
model FeaturedPost {
  id        String   @id @default(cuid())
  url       String   @unique
  title     String
  subtitle  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

/// "Updates & What's New" feed entries (admin-managed), usually built around an
/// X post link, with an optional title/note and tag. Pinned items show first.
model Update {
  id        String   @id @default(cuid())
  title     String?
  body      String?
  xUrl      String? // https://x.com/…/status/…
  tag       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([pinned])
  @@index([createdAt])
}

/// Bounty cycle config (admin-managed). One row per period; the `active` one
/// drives the /bounties/irl page, prizes, judging, minimums and submit form.
/// `prizes` and `judging` are stored as JSON strings.
model Bounty {
  id            String   @id @default(cuid())
  period        String   @unique // e.g. "2026-09"
  windowLabel   String
  prizePoolUsd  Int      @default(0)
  prizes        String   @default("[]") // JSON: [{ place, amountUsd, note }]
  minAttendees  Int      @default(4)
  minNewToZcash Int      @default(2)
  minMinutes    Int      @default(20)
  minPhotos     Int      @default(3)
  judging       String   @default("[]") // JSON: [{ label, weight }]
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([active])
}

/// Community events synced from Luma (admin-managed). Single source of truth for
/// the /events list, homepage "recent events", and the map's in-person cities.
model LumaEvent {
  id        String   @id @default(cuid())
  slug      String   @unique // lu.ma short code -> https://lu.ma/<slug>
  title     String
  startsAt  DateTime
  city      String
  state     String?
  venue     String?
  isOnline  Boolean  @default(false)
  series    String   @default("irl") // live | dev | irl
  coHosts   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([startsAt])
}

/// Event aftermovies / recap videos (admin-managed) shown in the grid on /events.
/// Source is EITHER a `url` (X post, YouTube, Vimeo, or an uploaded /uploads/*.mp4)
/// OR a raw `embed` snippet.
model Aftermovie {
  id        String    @id @default(cuid())
  title     String
  event     String
  city      String?
  url       String?
  embed     String?
  date      DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([sortOrder])
  @@index([city])
}
