// ZcashIND Prisma schema. Postgres (Prisma Postgres on Vercel).
// Enums are stored as strings to keep the schema portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A meetup / event / merchant pin. Public map shows only status = "verified".
model Meetup {
  id     String @id @default(cuid())
  slug   String @unique

  // kind: official_event | irl_bounty | merchant
  kind   String @default("irl_bounty")
  // status: pending | needs_info | verified | rejected | disqualified
  status String @default("pending")

  title   String
  city    String
  state   String?
  country String @default("India")

  lat Float
  lng Float

  // venueType: college | cafe | hostel | coworking | office | public | online | other
  venueType String  @default("other")
  venueName String?

  startsAt        DateTime
  endsAt          DateTime?
  timezone        String   @default("Asia/Kolkata")
  durationMinutes Int      @default(20)
  isOnline        Boolean  @default(false)
  language        String?

  // format: privacy_talk | zcash_intro | ironwood | quiz | dev | chai_privacy | college_discussion | live_stream | workshop | other
  format String @default("other")

  description String?
  summary     String?

  attendeesTotal      Int @default(0)
  attendeesNewToZcash Int @default(0)

  newCityActivation Boolean @default(false)
  nodeNumber        Int?

  registrationUrl String?

  // photos stored as a JSON string array of /uploads/... paths
  photos String @default("[]")

  brandingVisible Boolean @default(false)

  // Public-facing host name (safe to display).
  hostNamePublic String?
  // Private contact — NEVER exposed on public routes. Admin only.
  hostContactPrivate String?

  bountyPeriod String? // e.g. "2026-09"

  adminNotes      String?
  rejectionReason String?

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@index([status])
  @@index([kind])
  @@index([city])
}

/// Hand-picked @ZcashIND posts spotlighted on the site (admin-managed).
/// Powers the "Latest from @ZcashIND" feature when X's live widget can't render.
model FeaturedPost {
  id        String   @id @default(cuid())
  url       String   @unique
  title     String
  subtitle  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

/// "Updates & What's New" feed entries (admin-managed), usually built around an
/// X post link, with an optional title/note and tag. Pinned items show first.
model Update {
  id        String   @id @default(cuid())
  title     String?
  body      String?
  xUrl      String? // https://x.com/…/status/…
  tag       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([pinned])
  @@index([createdAt])
}

/// A bounty. Every bounty gets a public page at /bounties/<slug>. The row with
/// kind = "irl_meetup" and active = true also drives /bounties/irl, its prize
/// table, judging bars, minimums and the submit form.
/// `prizes` and `judging` are stored as JSON strings.
model Bounty {
  id     String @id @default(cuid())
  slug   String @unique
  title  String
  // kind: irl_meetup | mini_meetup | content | meme | video | explainer
  kind   String @default("content")
  // status: active | completed
  status String @default("active")

  description     String? // markdown
  format          String? // one line: what kind of submissions
  rules           String? // markdown
  topics          String? // comma separated
  acceptedFormats String? // comma separated

  startDate DateTime
  endDate   DateTime?

  announcementUrl       String?
  winnerAnnouncementUrl String?
  submissionCount       Int     @default(0)
  winnerCount           Int     @default(0)

  prizePoolUsd        Int    @default(0)
  /// The pool announced at launch, when it was later increased.
  initialPrizePoolUsd Int?
  currency            String @default("ZEC")
  prizes       String @default("[]") // JSON: [{ place, amountUsd, note }]

  // IRL meetup config (only meaningful for kind = irl_meetup).
  period        String? // e.g. "2026-09"
  windowLabel   String?
  minAttendees  Int     @default(4)
  minNewToZcash Int     @default(2)
  minMinutes    Int     @default(20)
  minPhotos     Int     @default(3)
  judging       String  @default("[]") // JSON: [{ label, weight }]
  active        Boolean @default(false)

  winners     BountyWinner[]
  submissions BountySubmission[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([active])
  @@index([startDate])
}

model BountyWinner {
  id            String  @id @default(cuid())
  bountyId      String
  bounty        Bounty  @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  /// Display name (usually the handle; a plain name when the handle is unknown).
  name          String  @default("")
  /// X handle without the @, when known. Drives the profile link.
  xHandle       String?
  // e.g. "1st", "2nd", "3rd", "Honorable mention", "Successful host", "Community pick"
  place         String
  prizeUsd      Int
  submissionUrl String?
  sortOrder     Int     @default(0)

  @@index([bountyId])
}

model BountySubmission {
  id       String  @id @default(cuid())
  bountyId String
  bounty   Bounty  @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  xHandle  String?
  url      String
  sortOrder Int    @default(0)

  @@index([bountyId])
}

/// Community events synced from Luma (admin-managed). Single source of truth for
/// the /events list, homepage "recent events", and the map's in-person cities.
model LumaEvent {
  id        String   @id @default(cuid())
  slug      String   @unique // lu.ma short code -> https://lu.ma/<slug>
  title     String
  startsAt  DateTime
  city      String
  state     String?
  venue     String?
  isOnline  Boolean  @default(false)
  series    String   @default("irl") // live | dev | irl
  coHosts   String?
  lat       Float?
  lng       Float?
  attendees Int?    // headcount, when known
  note      String? // e.g. "150+ new Zodl wallets"
  topics    String? // comma separated
  xUrl      String? // recap / thread on X
  createdAt DateTime @default(now())

  @@index([startsAt])
}

/// Event aftermovies / recap videos (admin-managed) shown in the grid on /events.
/// Source is EITHER a `url` (X post, YouTube, Vimeo, or an uploaded /uploads/*.mp4)
/// OR a raw `embed` snippet.
model Aftermovie {
  id        String    @id @default(cuid())
  title     String
  event     String
  city      String?
  url       String?
  embed     String?
  date      DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([sortOrder])
  @@index([city])
}
