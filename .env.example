# --- ZcashIND environment ---

# SQLite database (Prisma). For local dev keep as-is.
DATABASE_URL="file:./dev.db"

# Admin password for /admin login. CHANGE THIS before deploying.
ADMIN_PASSWORD="zcashindia"

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_COOKIE_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for OG/SEO metadata). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional map basemap style URL. Defaults to a free CARTO dark style if unset.
NEXT_PUBLIC_MAP_STYLE="https://tiles.openfreemap.org/styles/dark"

# Optional geocoding key. If missing, submit form degrades to click-the-map + city text.
NEXT_PUBLIC_GEOCODER_KEY=""
